   fetch(req) {
     const u = new URL(req.url);
     if (u.pathname.startsWith("/api/")) return app.fetch(req);
-    return new Response(dashboard(), { headers: { "content-type": "text/html" } });
+    return staticFile(u.pathname);
   },
 });
