// CellIQ — Cloudflare edge tier (generated by create-workiq)
// Secrets are 'wrangler secret'; ${...} placeholders come from 'wrangler create'.
{
  "name": "celliq",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "account_id": "${CF_ACCOUNT_ID}",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "production",
    "ACCESS_TEAM_DOMAIN": "lockstep.cloudflareaccess.com",
    "ACCESS_AUD": "${ACCESS_AUD}",
    "FLEETIQ_MIGRATE_TOKEN": ""
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "APP",
        "class_name": "AppData"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AppData"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "celliq",
      "database_id": "${D1_ID}",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "${KV_ID}"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "celliq-artifacts"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INGEST_Q",
        "queue": "celliq-ingest"
      }
    ],
    "consumers": [
      {
        "queue": "celliq-ingest"
      }
    ]
  },
  "triggers": {
    "crons": [
      "0 */6 * * *"
    ]
  }
}
