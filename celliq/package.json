{
  "name": "celliq",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "CellIQ — a WorkIQ edge app",
  "scripts": {
    "dev": "bun run src/index.ts",
    "verify": "tsc --noEmit",
    "test": "bun test",
