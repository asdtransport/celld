    "seed": "bun run src/seed.ts",
    "deploy": "cd cloudflare && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "drizzle-orm": "0.38.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/node": "22.10.2",
    "bun-types": "^1.1.34",
    "drizzle-kit": "^0.30.1",
    "esbuild": "0.25",
    "typescript": "5.7.3",
    "wrangler": "^3.99.0"
  },
  "overrides": {
    "drizzle-orm": "0.38.3",
    "typescript": "5.7.3",
    "@types/node": "22.10.2"
  }
}