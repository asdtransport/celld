# ---- add to deploy/celld/.env at the site (behind NAT) for the oss-tunnel profile ----
FRP_SERVER_ADDR=edge.example.com         # the edge VPS
FRP_SERVER_PORT=7000
FRP_TOKEN=change-me-long-random          # same as the edge
FRP_LOCAL_HOST=lb
FRP_LOCAL_PORT=8080
# Worker gate for the open-source edge (printed by deploy/oss/keygen.sh):
APP_AUTH_MODE=edge
APP_AUTH_PUBLIC_KEY_B64=
APP_AUTH_ALLOWED_ROLES=authp/admin,authp/user
# FleetIQ (profile: console) — frpc admin API credentials it uses to manage tunnels
FRPC_USER=admin
FRPC_PASS=change-me-long-random
FLEET_BUCKET=s3://celliq-fleet           # bucket only; each app gets its own prefix
