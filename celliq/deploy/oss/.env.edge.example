# ---- edge (public VPS) ----
SITE_ADDRESS=celliq.example.com          # Caddy gets a Let's Encrypt cert for this name automatically
UPSTREAM=frps:6000                       # tunnel mode; same-host mode: lb:8080 + FLEET_EXTERNAL=true
FLEET_EXTERNAL=false
CELLIQ_ADMIN_USER=admin
CELLIQ_ADMIN_EMAIL=admin@example.com
CELLIQ_ADMIN_PASSWORD=change-me-Long-Passphrase-1   # bootstrap admin; add more users in the portal
TOKEN_LIFETIME=3600
COOKIE_INSECURE=disabled                 # keep 'disabled' (Secure cookies) everywhere but plain-HTTP tests
CADDY_EXTRA_GLOBAL=                      # e.g. "local_certs" for an internal CA, "email ops@example.com" for ACME
FRP_TOKEN=change-me-long-random          # must match the site
CONSOLE_ADDRESS=console.example.com      # FleetIQ console hostname (same sign-in portal)
CONSOLE_UPSTREAM=frps:6001               # same-host mode: fleetiq:8790 with FLEET_EXTERNAL=true
