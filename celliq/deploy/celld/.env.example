# ---- fleet bucket (holds deployments, cell state, ownership records) ----
# Cloudflare R2:   CELLD_BUCKET=s3://celliq-fleet   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com   AWS_REGION=auto
# AWS S3:          CELLD_BUCKET=s3://celliq-fleet   (leave S3_ENDPOINT empty)                                  AWS_REGION=us-east-1
# local-s3 profile: CELLD_BUCKET=s3://celliq-fleet  S3_ENDPOINT=http://s3:8333                                 AWS_REGION=us-east-1
CELLD_BUCKET=s3://celliq-fleet
S3_ENDPOINT=http://s3:8333
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=celldkey
AWS_SECRET_ACCESS_KEY=change-me-long-random

# ---- app vars baked into each deployment (read by the `deploy` service) ----
APP_ENVIRONMENT=production
# access = verify the Cloudflare Access JWT (use with the tunnel profile); none = private network only
APP_AUTH_MODE=none
APP_ACCESS_TEAM_DOMAIN=lockstep.cloudflareaccess.com
APP_ACCESS_AUD=

# ---- tunnel profile ----
TUNNEL_TOKEN=

# ---- tuning (optional) ----
# CELLD_MAX_RESIDENT_CELLS=1000
# CELLD_MAX_RSS_MB=0
