---
import Console from "../layouts/Console.astro";
import Drawer from "../components/Drawer.astro";
---
<Console title="Application" active="apps">
  <div class="crumbs"><a href="/apps">Applications</a></div>
  <header class="page-head">
    <div>
      <h1 id="title">Application</h1>
      <p id="subtitle" class="skeleton">Loading this application</p>
    </div>
    <div class="actions">
      <button class="btn" type="button" id="diag-btn">Run diagnostics</button>
      <button class="btn" type="button" data-drawer-open="scale" data-operator id="scale-btn" hidden>Scale nodes</button>
      <button class="btn" type="button" data-drawer-open="deploy" data-operator>Upload a version</button>
      <button class="btn primary" type="button" id="git-deploy-btn" data-operator hidden>Deploy from Git</button>
    </div>
  </header>

  <div id="diag" hidden class="panel" style="margin-bottom:18px"></div>

  <section class="panel">
    <div class="panel-head"><h2>Nodes</h2><span class="hint" id="nodes-hint"></span></div>
    <div class="table-wrap" id="nodes"><div class="empty skeleton">Reading node leases</div></div>
  </section>

  <div class="grid-2" style="margin-top:18px">
    <section class="panel">
      <div class="panel-head"><h2>Versions</h2><span class="hint">Rolling back moves the live pointer and reloads every node.</span></div>
      <div class="table-wrap" id="versions"><div class="empty skeleton">Listing versions</div></div>
    </section>
    <section class="panel">
      <div class="panel-head"><h2>Configuration</h2></div>
      <div class="panel-body" id="summary"><div class="skeleton">Loading</div></div>
    </section>
  </div>

  <section class="panel" style="margin-top:18px">
    <div class="panel-head"><h2>Also on Cloudflare</h2><button class="btn sm" type="button" id="cf-add-btn" data-operator>Deploy to Cloudflare</button></div>
    <div class="panel-body" id="cf"><div class="skeleton">Loading</div></div>
  </section>

  <section class="panel" style="margin-top:18px">
    <div class="panel-head"><h2>Source</h2><button class="btn sm" type="button" data-drawer-open="git" data-operator id="git-edit-btn">Connect GitHub</button></div>
    <div class="panel-body" id="source"><div class="skeleton">Loading</div></div>
  </section>

  <section class="panel" style="margin-top:18px">
    <div class="panel-head"><h2>Deployment history</h2></div>
    <div class="table-wrap" id="history"><div class="empty skeleton">Loading history</div></div>
  </section>

  <section class="panel" style="margin-top:18px" data-operator>
    <div class="panel-head"><h2>Remove application</h2></div>
    <div class="panel-body" style="display:flex;gap:16px;align-items:center;justify-content:space-between;flex-wrap:wrap">
      <p style="margin:0;color:var(--ink-2);max-width:70ch">Removes it from FleetIQ. Scale it to zero and remove its routes first. Its data stays in the bucket under its prefix.</p>
      <button class="btn danger" type="button" id="remove-btn">Remove application</button>
    </div>
  </section>

  <Drawer id="deploy" title="Deploy a version" submit="Upload and deploy" formId="deploy-form">
    <form id="deploy-form">
      <p style="margin:0 0 14px;color:var(--ink-2)">Upload the project as a <code>.tar.gz</code>: <code>wrangler.jsonc</code>, the Worker source with its <code>node_modules</code>, and built static assets. celld bundles it and stores a new version. D1 migrations in the project are applied after the deploy.</p>
      <label class="field"><span>Project archive</span><input type="file" name="bundle" accept=".tgz,.tar.gz,application/gzip" required />
        <small>For a WorkIQ app: <code>./workiq-pack.sh my-app</code>. Anything else: <code>tar czf app.tgz -C my-app .</code></small></label>
      <div class="notice info" id="deploy-name-note"></div>
      <div id="deploy-result" style="margin-top:14px"></div>
    </form>
  </Drawer>

  <Drawer id="scale" title="Scale nodes" submit="Apply" formId="scale-form">
    <form id="scale-form">
      <label class="field"><span>Nodes</span><input type="number" name="nodes" min="0" max="9" required />
        <small>New nodes join through the bucket in a few seconds. Removed nodes hand their cells to the others before stopping.</small></label>
      <div class="notice warn" id="scale-warn" hidden>One node waits on the bucket for every write, which is much slower. Two or more are recommended.</div>
    </form>
  </Drawer>

  <Drawer id="git" title="Git source" submit="Save source" formId="git-form">
    <form id="git-form">
      <label class="field"><span>Repository</span><input type="text" name="repo" required spellcheck="false" placeholder="asdtransport/my-app" />
        <small><code>owner/repo</code> on GitHub, or an https URL to a <code>.tar.gz</code>.</small></label>
      <label class="field"><span>Branch, tag or commit</span><input type="text" name="ref" value="main" spellcheck="false" /></label>
      <label class="field"><span>Project folder</span><input type="text" name="path" spellcheck="false" placeholder="(repo root)" />
        <small>Where <code>wrangler.jsonc</code> is, inside the repo. Leave empty to use the root or find it.</small></label>
      <label class="field"><span>GitHub token</span><input type="password" name="token" autocomplete="off" placeholder="Only for private repos" />
        <small>A fine-grained token with read access to this repo’s contents. Leave empty to keep the saved one.</small></label>
      <label class="check"><input type="checkbox" name="checks" checked /><span>Run the type check and tests while building<small>The deploy stops if they fail.</small></span></label>
      <label class="check"><input type="checkbox" name="autoDeploy" /><span>Deploy on every push<small>Add the webhook shown on this page to the GitHub repo.</small></span></label>
    </form>
  </Drawer>

  <Drawer id="cf-link" title="Deploy to Cloudflare" submit="Save" formId="cf-form">
    <form id="cf-form">
      <label class="field"><span>Cloudflare account</span><select name="target" id="cf-target" required></select><small id="cf-target-note"></small></label>
      <label class="field"><span>Hostname</span><input type="text" name="hostname" spellcheck="false" placeholder="crm.example.com" />
        <small>A name on one of the account’s domains; Cloudflare creates the DNS record and certificate. Leave empty for a <code>workers.dev</code> address.</small></label>
      <label class="check"><input type="checkbox" name="access" checked /><span>Protect with Cloudflare Access<small>Visitors sign in through your Zero Trust team before reaching the app. Needs a hostname.</small></span></label>
      <label class="field"><span>Who can sign in</span><textarea name="allow" rows="3" spellcheck="false" placeholder="derek@example.com&#10;@lockstep.com"></textarea><small>One email per line, or <code>@domain.com</code> for everyone at a domain.</small></label>
      <label class="field"><span>Worker name</span><input type="text" name="workerName" spellcheck="false" /></label>
    </form>
  </Drawer>

  <Drawer id="log" title="Deployment log">
    <div id="log-body"></div>
  </Drawer>
</Console>

<script>
  import { $, act, ago, api, bytes, confirmAction, errorPanel, esc, gateOperatorControls, qs, short, statusClass, toast, when } from "../lib/api";
  const name = qs("name") ?? "";
  if (!name) location.replace("/apps");
  let data: any = null;

  async function load() {
    try {
      data = await api<any>(`/api/apps/${encodeURIComponent(name)}`);
      const { app, fleet, bindings, routes } = data;
      document.title = `${app.name} · FleetIQ`;
      $("#title").textContent = app.name;
      const sub = $("#subtitle"); sub.classList.remove("skeleton");
      sub.textContent = fleet.version ? `Live version ${fleet.version}. ${app.description ?? ""}` : `Not deployed yet. ${app.description ?? "Upload a project to create the first version."}`;
      $("#scale-btn").hidden = !app.managed;
      (document.querySelector('#scale-form input[name="nodes"]') as HTMLInputElement).value = String(app.desiredNodes);
      $("#deploy-name-note").innerHTML = `The project’s wrangler <code>name</code> must be <code>${esc(app.name)}</code>.`;
      renderNodes(app, fleet);
      renderSummary(app, fleet, bindings, routes);
    } catch (e) { errorPanel($("#nodes"), e, load); }
    loadVersions(); loadHistory(); loadSource().then(loadCf);
  }

  // ---- Cloudflare targets ----
  let cfTargets: any[] = []; let cfLinks: any[] = [];
  async function loadCf() {
    const el = $("#cf");
    try {
      [cfTargets, cfLinks] = await Promise.all([api<any[]>("/api/targets"), api<any[]>(`/api/apps/${encodeURIComponent(name)}/targets`)]);
      $("#cf-target").innerHTML = cfTargets.map((t) => `<option value="${esc(t.id)}">${esc(t.name)} (${esc(t.accountId.slice(0, 8))}…)</option>`).join("");
      $("#cf-add-btn").hidden = !cfTargets.length || cfTargets.every((t) => cfLinks.some((l) => l.target === t.id));
      if (!cfTargets.length) { el.innerHTML = `<p style="margin:0;color:var(--ink-2)">Run this application on Cloudflare too: the same version, with its own D1, KV and R2, behind Cloudflare Access. <a href="/targets">Add a Cloudflare account</a> first.</p>`; return; }
      if (!cfLinks.length) { el.innerHTML = `<p style="margin:0;color:var(--ink-2)">Not deployed to Cloudflare. Choose <strong>Deploy to Cloudflare</strong> to pick an account, a hostname and who can sign in.</p>`; return; }
      el.innerHTML = cfLinks.map((l) => `<div class="cf-link"><dl class="kv-list">
          <dt>Account</dt><dd>${esc(l.targetName)} · Worker <code>${esc(l.workerName)}</code></dd>
          <dt>Address</dt><dd>${l.url ? `<a href="${esc(l.url)}" target="_blank" rel="noopener">${esc(l.url)}</a>` : l.hostname ? `<code>${esc(l.hostname)}</code> (not deployed yet)` : "workers.dev (not deployed yet)"}</dd>
          <dt>Sign-in</dt><dd>${l.access ? `Cloudflare Access: ${l.allow.map((a: string) => `<code>${esc(a)}</code>`).join(", ")}; <code>${esc(l.healthPath)}</code> open` : `<span class="status warn">Public</span>`}</dd>
          <dt>Last deploy</dt><dd>${l.lastVersion ? `<code>${esc(l.lastVersion.slice(0, 13))}</code> ${ago(l.lastDeployAt)}` : "Never"}</dd>
        </dl>
        <div class="secret-actions" style="margin-top:12px">
          <button class="btn sm primary" type="button" data-operator data-cf-deploy="${esc(l.target)}" data-from="current">Deploy the version running here</button>
          ${source ? `<button class="btn sm" type="button" data-operator data-cf-deploy="${esc(l.target)}" data-from="git">Deploy from Git</button>` : ""}
          <button class="btn sm" type="button" data-operator data-cf-deploy="${esc(l.target)}" data-from="current" data-dry="1">Dry run</button>
          ${l.url ? `<button class="btn sm" type="button" data-cf-verify="${esc(l.target)}">Verify</button>` : ""}
          <button class="btn sm" type="button" data-operator data-cf-edit="${esc(l.target)}">Edit</button>
          <button class="btn sm danger" type="button" data-operator data-cf-unlink="${esc(l.target)}" data-tname="${esc(l.targetName)}">Unlink</button>
        </div></div>`).join("");
      el.querySelectorAll<HTMLButtonElement>("[data-cf-deploy]").forEach((b) => b.addEventListener("click", async () => {
        const dry = b.dataset.dry === "1";
        if (!dry && !(await confirmAction({ title: `Deploy ${name} to Cloudflare?`, text: b.dataset.from === "git" ? "FleetIQ builds the Git source and deploys it with wrangler. Missing D1, KV, R2 and queues are created; Access is set up for the hostname." : "FleetIQ deploys the exact version running here with wrangler. Missing D1, KV, R2 and queues are created; Access is set up for the hostname.", ok: "Deploy" }))) return;
        let d: any; if (await act(b, async () => { d = await api(`/api/apps/${encodeURIComponent(name)}/targets/${b.dataset.cfDeploy}/deploy`, { method: "POST", json: { from: b.dataset.from, dryRun: dry } }); }, dry ? "Dry run started" : "Deploying to Cloudflare")) showLog(d.id, true).then(loadCf);
      }));
      el.querySelectorAll<HTMLButtonElement>("[data-cf-verify]").forEach((b) => b.addEventListener("click", async () => {
        let r: any; if (await act(b, async () => { r = await api(`/api/apps/${encodeURIComponent(name)}/targets/${b.dataset.cfVerify}/verify`, { method: "POST" }); }, "Checked")) {
          $("#log-body").innerHTML = `<pre class="log">${esc(r.result)}</pre>`; (document.getElementById("log") as HTMLDialogElement).showModal();
        }
      }));
      el.querySelectorAll<HTMLButtonElement>("[data-cf-edit]").forEach((b) => b.addEventListener("click", () => openCf(cfLinks.find((l) => l.target === b.dataset.cfEdit))));
      el.querySelectorAll<HTMLButtonElement>("[data-cf-unlink]").forEach((b) => b.addEventListener("click", async () => {
        if (!(await confirmAction({ title: `Unlink ${name} from ${b.dataset.tname}?`, text: "FleetIQ stops deploying there. The Worker, its data and the Access app on Cloudflare are left as they are.", ok: "Unlink" }))) return;
        if (await act(b, () => api(`/api/apps/${encodeURIComponent(name)}/targets/${b.dataset.cfUnlink}`, { method: "DELETE" }), "Unlinked")) loadCf();
      }));
      gateOperatorControls(el);
    } catch (e) { errorPanel(el, e, loadCf); }
  }
  function openCf(l?: any) {
    const f = $<HTMLFormElement>("#cf-form"); f.reset();
    const el = (n: string) => f.elements.namedItem(n) as HTMLInputElement;
    if (l) { el("target").value = l.target; el("hostname").value = l.hostname ?? ""; el("access").checked = l.access; (f.elements.namedItem("allow") as HTMLTextAreaElement).value = l.allow.join("\n"); el("workerName").value = l.workerName; }
    else el("workerName").value = name;
    (document.getElementById("cf-link") as HTMLDialogElement).showModal();
  }
  $("#cf-add-btn").addEventListener("click", () => openCf());
  $<HTMLFormElement>("#cf-form").addEventListener("submit", async (ev) => {
    ev.preventDefault(); const f = new FormData(ev.target as HTMLFormElement);
    const body = { hostname: String(f.get("hostname") || "").trim() || null, access: f.get("access") === "on", allow: String(f.get("allow") || "").split(/[\s,]+/).map((s) => s.trim()).filter(Boolean), workerName: String(f.get("workerName") || "").trim() || undefined };
    if (await act(document.querySelector('button[form="cf-form"]'), () => api(`/api/apps/${encodeURIComponent(name)}/targets/${f.get("target")}`, { method: "PUT", json: body }), "Saved")) { (document.getElementById("cf-link") as HTMLDialogElement).close(); loadCf(); }
  });

  // ---- Git source ----
  let source: any = null;
  async function loadSource() {
    const el = $("#source");
    try {
      source = await api<any>(`/api/apps/${encodeURIComponent(name)}/source`);
      $("#git-deploy-btn").hidden = !source;
      $("#git-edit-btn").textContent = source ? "Edit" : "Connect GitHub";
      if (!source) { el.innerHTML = `<p style="margin:0;color:var(--ink-2)">Connect a GitHub repo to build and deploy this application from source, by button, API or on every push. FleetIQ builds in a throwaway container, so nothing needs installing on your computer.</p>`; return; }
      const repoLink = /^[\w.-]+\/[\w.-]+$/.test(source.repo) ? `<a href="https://github.com/${esc(source.repo)}/tree/${encodeURIComponent(source.ref)}${source.path ? `/${esc(source.path)}` : ""}" rel="noopener" target="_blank">${esc(source.repo)}</a>` : esc(source.repo);
      el.innerHTML = `<dl class="kv-list">
        <dt>Repository</dt><dd>${repoLink}${source.hasToken ? ` <span class="tag">private, token saved</span>` : ""}</dd>
        <dt>Builds</dt><dd><code>${esc(source.ref)}</code>${source.path ? `, folder <code>${esc(source.path)}</code>` : ""}${source.checks ? "" : " (checks skipped)"}</dd>
        <dt>Last built commit</dt><dd>${source.lastCommit ? `<code>${esc(source.lastCommit.slice(0, 12))}</code>` : "None yet"}</dd>
        <dt>Deploy on push</dt><dd>${source.autoDeploy ? `<span class="status ok">On</span>` : `<span class="status off">Off</span>`}</dd>
        ${source.webhookSecret ? `<dt>GitHub webhook</dt><dd>Payload URL <code>${esc(source.webhookUrl)}</code>, content type <code>application/json</code>, secret <code class="copyable" id="wh-secret" title="Click to copy">${esc(source.webhookSecret)}</code>, just the push event.</dd>` : ""}
      </dl>`;
      document.getElementById("wh-secret")?.addEventListener("click", () => navigator.clipboard.writeText(source.webhookSecret).then(() => toast("Secret copied")).catch(() => {}));
      const f = $<HTMLFormElement>("#git-form");
      (f.elements.namedItem("repo") as HTMLInputElement).value = source.repo;
      (f.elements.namedItem("ref") as HTMLInputElement).value = source.ref;
      (f.elements.namedItem("path") as HTMLInputElement).value = source.path;
      (f.elements.namedItem("checks") as HTMLInputElement).checked = source.checks;
      (f.elements.namedItem("autoDeploy") as HTMLInputElement).checked = source.autoDeploy;
    } catch (e) { errorPanel(el, e, loadSource); }
  }
  $<HTMLFormElement>("#git-form").addEventListener("submit", async (ev) => {
    ev.preventDefault();
    const f = new FormData(ev.target as HTMLFormElement);
    const body: any = { repo: String(f.get("repo")).trim(), ref: String(f.get("ref") || "main").trim(), path: String(f.get("path") || "").trim(), checks: f.get("checks") === "on", autoDeploy: f.get("autoDeploy") === "on" };
    if (f.get("token")) body.token = String(f.get("token"));
    if (await act(document.querySelector('button[form="git-form"]'), () => api(`/api/apps/${encodeURIComponent(name)}/source`, { method: "PUT", json: body }), "Source saved")) {
      (document.getElementById("git") as HTMLDialogElement).close(); loadSource();
    }
  });
  $("#git-deploy-btn").addEventListener("click", async (ev) => {
    const btn = ev.currentTarget as HTMLButtonElement;
    let dep: any = null;
    if (!(await act(btn, async () => { dep = await api(`/api/apps/${encodeURIComponent(name)}/deploy/git`, { method: "POST", json: {} }); }, `Building ${source?.repo}@${source?.ref}`)) || !dep) return;
    showLog(dep.id, true);
  });

  // Live log for a deployment; refreshes while it runs.
  async function showLog(id: string, live = false) {
    const dlg = document.getElementById("log") as HTMLDialogElement;
    if (!dlg.open) dlg.showModal();
    const draw = (d: any) => {
      const pre = document.getElementById("live-log");
      const atBottom = !pre || pre.scrollTop + pre.clientHeight >= pre.scrollHeight - 20;
      $("#log-body").innerHTML = `<p style="margin:0 0 10px"><span class="status ${statusClass(d.status)}">${d.status === "running" ? "Building and deploying" : esc(d.status)}</span> ${esc(when(d.startedAt))}${d.source ? `<span class="sub">${esc(d.source)}</span>` : ""}</p><pre class="log" id="live-log" style="max-height:60vh">${esc(d.log || "Starting…")}</pre>`;
      const np = document.getElementById("live-log")!; if (atBottom) np.scrollTop = np.scrollHeight;
    };
    let d = await api<any>(`/api/deployments/${id}`); draw(d);
    while ((live || d.status === "running") && d.status === "running" && dlg.open) {
      await new Promise((r) => setTimeout(r, 2000));
      d = await api<any>(`/api/deployments/${id}`); draw(d);
    }
    if (d.status !== "running") { loadHistory(); if (d.status === "succeeded") { toast(`Deployed ${short(d.version)}`); load(); } }
  }

  function renderNodes(app: any, fleet: any) {
    $("#nodes-hint").textContent = `${fleet.live} live${app.managed ? ` of ${app.desiredNodes} wanted` : ""}`;
    if (!fleet.nodes.length) {
      $("#nodes").innerHTML = `<div class="empty"><strong>No nodes have joined</strong>${app.managed ? "Scale this application up to start nodes." : "Start the nodes where they are defined; they appear here once they hold a lease in the bucket."}</div>`;
      return;
    }
    $("#nodes").innerHTML = `<table class="data"><thead><tr><th>Node</th><th>Lease</th><th>Running</th><th>Cells</th><th class="num">Memory</th><th class="num">CPU</th></tr></thead><tbody>${
      fleet.nodes.map((n: any) => {
        const s = n.state && !n.state.error ? n.state : null;
        const lag = s && fleet.version && s.version && s.version !== fleet.version;
        return `<tr>
          <td style="white-space:nowrap"><code>${esc(n.addr.split(":")[0])}</code><span class="sub">node ${esc(short(n.id.replace(/^node_/, ""), 10))}</span></td>
          <td style="white-space:nowrap">${n.fresh ? `<span class="status ok">Held</span><span class="sub">renews in ${Math.max(0, Math.round(n.expiresInMs / 1000))} s</span>`
            : -n.expiresInMs > 1e11 ? `<span class="status off">Left the fleet</span><span class="sub">shut down cleanly</span>`
            : `<span class="status bad">Expired</span><span class="sub">${Math.round(-n.expiresInMs / 1000)} s ago</span>`}</td>
          <td>${s ? `<code>${esc(short(s.version, 16))}</code>${lag ? `<span class="sub" style="color:var(--warn)">Switching to ${esc(short(fleet.version, 7))}</span>` : ""}` : n.state?.error ? `<span class="status bad">Unreachable</span><span class="sub">${esc(n.state.error)}</span>` : "—"}</td>
          <td>${s ? `<div class="cells" title="${s.owned} owned, ${s.resident} in memory">${Array.from({ length: Math.min(s.owned, 60) }).map((_, i) => `<i class="${(s.cells[i] ?? "").startsWith("__") || (s.cells[i] ?? "").startsWith(".") ? "sys" : ""}"></i>`).join("")}</div><span class="sub" style="white-space:nowrap">${s.owned} owned</span>` : "—"}</td>
          <td class="num">${s ? bytes(s.rssBytes) : "—"}${s?.pressured ? `<span class="sub" style="color:var(--bad)">Under pressure</span>` : ""}</td>
          <td class="num">${s ? `${s.cpuPercent.toFixed(1)}%` : "—"}</td></tr>`;
      }).join("")}</tbody></table>`;
  }

  function renderSummary(app: any, fleet: any, b: any, routes: any[]) {
    const link = (kind: string, id: string, label: string) => `<a href="/data?app=${encodeURIComponent(app.name)}&kind=${kind}&id=${encodeURIComponent(id)}">${esc(label)}</a>`;
    const list = (arr: string[]) => arr.length ? arr.join(", ") : `<span class="sub" style="display:inline">None</span>`;
    $("#summary").innerHTML = `<dl class="kv">
      <dt>Nodes run by</dt><dd>${app.managed ? `FleetIQ (image <code>${esc(app.nodeImage ?? "default")}</code>)` : "Outside FleetIQ"}</dd>
      <dt>Bucket prefix</dt><dd><code>${esc(app.prefix)}/</code></dd>
      <dt>Public hostnames</dt><dd>${routes.length ? routes.map((r) => `<code>${esc(r.host === "*" ? "Any other host" : r.host)}</code>`).join(", ") : `None. <a href="/routes">Add a route</a>`}</dd>
      <dt>Health check</dt><dd><code>${esc(app.healthPath)}</code></dd>
      <dt>Durable Objects</dt><dd>${list(b.durableObjects.map((d: any) => link("objects", d.className, d.className)))}</dd>
      <dt>KV namespaces</dt><dd>${list(b.kv.map((k: any) => link("kv", k.id, `${k.binding} (${k.id})`)))}</dd>
      <dt>D1 databases</dt><dd>${list(b.d1.map((d: any) => link("d1", d.name, `${d.binding} (${d.name})`)))}</dd>
      <dt>Queues</dt><dd>${list(b.queues.map((q: any) => link("queues", q.queue, `${q.binding} (${q.queue})`)))}</dd>
      <dt>R2 buckets</dt><dd>${list(b.r2.map((r: any) => link("r2", r.bucket, `${r.binding} (${r.bucket})`)))}</dd>
      <dt>Schedules</dt><dd>${b.crons.length ? b.crons.map((c: string) => `<code>${esc(c)}</code>`).join(", ") : list([])}</dd>
      <dt>Variables</dt><dd>${b.vars.length ? b.vars.map((v: any) => `<code>${esc(v.name)}</code>`).join(", ") : list([])}</dd>
    </dl>`;
  }

  async function loadVersions() {
    const el = $("#versions");
    try {
      const vs = await api<any[]>(`/api/apps/${encodeURIComponent(name)}/versions`);
      el.innerHTML = vs.length ? `<table class="data"><thead><tr><th>Version</th><th>Uploaded</th><th></th></tr></thead><tbody>${
        vs.map((v) => `<tr><td><code>${esc(v.version)}</code> ${v.current ? `<span class="tag teal">Live</span>` : ""}</td>
          <td title="${esc(when(v.uploadedAt))}">${ago(v.uploadedAt)}</td>
          <td class="row-actions">${v.current ? "" : `<button class="btn sm" type="button" data-operator data-rollback="${esc(v.version)}">Roll back to this</button>`}</td></tr>`).join("")}</tbody></table>`
        : `<div class="empty">No versions yet. Deploy a project to create the first one.</div>`;
      el.querySelectorAll<HTMLButtonElement>("[data-rollback]").forEach((b) => b.addEventListener("click", () => rollback(b)));
      const { gateOperatorControls } = await import("../lib/api"); gateOperatorControls(el);
    } catch (e) { errorPanel(el, e, loadVersions); }
  }

  async function rollback(btn: HTMLButtonElement) {
    const v = btn.dataset.rollback!;
    if (!(await confirmAction({ title: `Roll ${name} back to ${v.slice(0, 7)}?`, text: "Live traffic moves to this version as each node picks it up. Durable Object data is not rolled back.", ok: "Roll back", typed: name }))) return;
    let warning: string | null = null;
    const ok = await act(btn, async () => { const d = await api<any>(`/api/apps/${encodeURIComponent(name)}/rollback`, { method: "POST", json: { version: v } }); warning = d.warning; }, `Rolled back to ${v.slice(0, 7)}`);
    if (ok && warning) toast(`${warning}. See the deployment log.`, "bad");
    if (ok) setTimeout(load, 400);
  }

  async function loadHistory() {
    const el = $("#history");
    try {
      const ds = await api<any[]>(`/api/apps/${encodeURIComponent(name)}/deployments`);
      el.innerHTML = ds.length ? `<table class="data"><thead><tr><th>Change</th><th>Result</th><th>When</th></tr></thead><tbody>${
        ds.map((d) => {
          const reason = d.status === "failed" ? String(d.log ?? "").trim().split("\n").pop() : "";
          const what = d.kind === "cloudflare" ? `${d.status === "running" ? "Deploying" : d.status === "failed" ? "Couldn’t deploy" : /dry run/.test(d.source ?? "") ? "Checked a deploy" : "Deployed"} to ${esc(d.source ?? "Cloudflare")}${d.version ? ` <code>${esc(short(d.version, 8))}</code>` : ""}` : d.status === "running" ? `Building and deploying ${esc(d.source ?? "")}` : d.status === "failed"
            ? `${d.kind === "rollback" ? "Rollback" : "Deploy"} of ${esc(d.kind === "rollback" ? short(d.source) : d.source ?? "upload")} rejected`
            : d.kind === "rollback" ? `Rolled back <code>${esc(short(d.previousVersion))}</code> to <code>${esc(short(d.version))}</code>`
            : d.previousVersion ? `Deployed <code>${esc(short(d.version))}</code>, replacing <code>${esc(short(d.previousVersion))}</code>` : `Deployed <code>${esc(short(d.version))}</code>, the first version`;
          return `<tr><td>${what}${reason ? `<span class="sub" style="color:var(--bad)">${esc(reason)}</span>` : ""}<span class="sub">by ${esc(d.actor)}${d.source && d.kind === "deploy" && d.status !== "failed" ? `, from ${esc(d.source)}` : ""}</span></td>
          <td><span class="status ${statusClass(d.status)}">${d.status === "succeeded" ? "Succeeded" : d.status === "failed" ? "Failed" : "Running"}</span></td>
          <td style="white-space:nowrap">${ago(d.startedAt)} <button class="btn sm" type="button" data-log="${esc(d.id)}">Log</button></td></tr>`; }).join("")}</tbody></table>`
        : `<div class="empty">No deployments from FleetIQ yet. Versions deployed with the celld CLI still appear under Versions.</div>`;
      el.querySelectorAll<HTMLButtonElement>("[data-log]").forEach((b) => b.addEventListener("click", () => showLog(b.dataset.log!)));
      if (ds.some((d) => d.status === "running")) setTimeout(loadHistory, 4000);
    } catch (e) { errorPanel(el, e, loadHistory); }
  }

  // ---- deploy ----
  $<HTMLFormElement>("#deploy-form").addEventListener("submit", async (ev) => {
    ev.preventDefault();
    const form = ev.target as HTMLFormElement;
    const btn = document.querySelector<HTMLButtonElement>('button[form="deploy-form"]');
    const out = $("#deploy-result"); out.innerHTML = "";
    const ok = await act(btn, async () => {
      try {
        const d = await api<any>(`/api/apps/${encodeURIComponent(name)}/deploy`, { method: "POST", body: new FormData(form) });
        out.innerHTML = `<div class="notice ${d.warning ? "warn" : "info"}">Version <code>${esc(d.version)}</code> is live${d.warning ? `, but ${esc(d.warning)}. Open the log below for each node’s reason.` : d.nodes.length ? ` on ${d.nodes.length} node${d.nodes.length === 1 ? "" : "s"}.` : `. No node was running yet; nodes load it as they start.`}</div><pre class="log" style="margin-top:10px">${esc(d.log)}</pre>`;
      } catch (e: any) { out.innerHTML = `<div class="notice bad">${esc(e.message)}</div>`; throw e; }
    }, "Deployed");
    if (ok) { form.reset(); load(); }
  });

  // ---- scale ----
  const scaleInput = document.querySelector('#scale-form input[name="nodes"]') as HTMLInputElement;
  scaleInput.addEventListener("input", () => { $("#scale-warn").hidden = Number(scaleInput.value) !== 1; });
  $<HTMLFormElement>("#scale-form").addEventListener("submit", async (ev) => {
    ev.preventDefault();
    const n = Number(scaleInput.value);
    if (data && n < data.app.desiredNodes && !(await confirmAction({ title: `Scale ${name} down to ${n}?`, text: n === 0 ? "Every node stops. The application stops serving until you scale it up again; its data stays in the bucket." : "Removed nodes hand their cells to the remaining ones, then stop.", ok: "Scale down", typed: n === 0 ? name : undefined }))) return;
    const btn = document.querySelector<HTMLButtonElement>('button[form="scale-form"]');
    if (await act(btn, () => api(`/api/apps/${encodeURIComponent(name)}/scale`, { method: "POST", json: { nodes: n } }), `${name} scaled to ${n} node${n === 1 ? "" : "s"}`)) {
      (document.getElementById("scale") as HTMLDialogElement).close();
      setTimeout(load, 2500);
    }
  });

  // ---- diagnostics ----
  $("#diag-btn").addEventListener("click", async () => {
    const panel = $("#diag"); panel.hidden = false;
    panel.innerHTML = `<div class="panel-head"><h2>Diagnostics</h2><span class="hint">Signed probes of every node and a bucket check</span></div><div class="empty skeleton">Probing</div>`;
    try {
      const checks = await api<any[]>(`/api/apps/${encodeURIComponent(name)}/diagnose`);
      panel.innerHTML = `<div class="panel-head"><h2>Diagnostics</h2><span class="hint">${checks.filter((c) => c.verdict === "ok").length} of ${checks.length} checks passed</span></div><div class="table-wrap"><table class="data"><tbody>${
        checks.map((c) => `<tr><td style="width:34%"><span class="status ${c.verdict === "ok" ? "ok" : c.verdict === "warn" ? "warn" : "bad"}">${esc(c.check)}</span></td><td><span class="sub" style="color:var(--ink-2)">${esc(c.detail || "")}</span></td></tr>`).join("")}</tbody></table></div>`;
    } catch (e) { errorPanel(panel, e); }
  });

  $("#remove-btn").addEventListener("click", async (ev) => {
    if (!(await confirmAction({ title: `Remove ${name} from FleetIQ?`, text: "The registry entry goes away. Bucket data and versions are kept.", ok: "Remove", typed: name }))) return;
    if (await act(ev.currentTarget as HTMLButtonElement, () => api(`/api/apps/${encodeURIComponent(name)}`, { method: "DELETE" }), `Removed ${name}`)) location.href = "/apps";
  });

  load();
  setInterval(() => { if (!document.hidden && !document.querySelector("dialog[open]") && data) api<any>(`/api/apps/${encodeURIComponent(name)}`).then((d) => { data = d; renderNodes(d.app, d.fleet); }).catch(() => {}); }, 10000);
</script>
