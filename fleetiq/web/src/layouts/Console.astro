---
import "@fontsource-variable/archivo/standard.css";
import "@fontsource/jetbrains-mono/400.css";
import "../styles/console.css";

interface Props { title: string; active: string }
const { title, active } = Astro.props;

// Grouped by job: run things, look at data, connect things, prove what happened.
const groups = [
  { label: "Run", items: [
    { id: "overview", href: "/", text: "Overview", icon: "M3 12h4l3-8 4 16 3-8h4" },
    { id: "apps", href: "/apps", text: "Applications", icon: "M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" },
    { id: "nodes", href: "/nodes", text: "Nodes", icon: "M4 5h16v5H4zM4 14h16v5H4zM8 7.5h.01M8 16.5h.01" },
  ] },
  { label: "Data", items: [
    { id: "data", href: "/data", text: "Data explorer", icon: "M4 6c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3zm0 0v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3" },
  ] },
  { label: "Network", items: [
    { id: "routes", href: "/routes", text: "Routes", icon: "M4 6h10a4 4 0 0 1 0 8H8a4 4 0 0 0 0 8h12M17 3l3 3-3 3" },
    { id: "tunnels", href: "/tunnels", text: "Tunnels", icon: "M3 18a9 9 0 0 1 18 0M7 18a5 5 0 0 1 10 0M12 18h.01" },
  ] },
  { label: "Govern", items: [
    { id: "system", href: "/system", text: "Containers", icon: "M3 7l9-4 9 4-9 4-9-4zm0 0v10l9 4 9-4V7M12 11v10" },
    { id: "access", href: "/access", text: "API & access", icon: "M15 7a4 4 0 1 1-3.9 4.9L4 19v-3h3v-3h3l1.1-1.1A4 4 0 0 1 15 7zm1.5 2.5h.01" },
    { id: "activity", href: "/activity", text: "Activity", icon: "M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z" },
  ] },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{title} · FleetIQ</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="shell">
      <aside class="rail" id="rail" aria-label="Main">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">{Array.from({ length: 9 }).map(() => <i />)}</span>
          <span><span class="brand-name">FleetIQ</span><span class="brand-sub">celld control plane</span></span>
        </a>
        {groups.map((g) => (
          <nav class="nav-group" aria-label={g.label}>
            <span>{g.label}</span>
            {g.items.map((i) => (
              <a href={i.href} aria-current={i.id === active ? "page" : undefined}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={i.icon} /></svg>
                {i.text}
              </a>
            ))}
          </nav>
        ))}
        <div class="rail-foot" id="whoami"><strong>Checking sign-in…</strong></div>
      </aside>
      <main class="main" id="main">
        <button class="btn menu-btn" type="button" id="menu-btn" aria-controls="rail" aria-expanded="false">Menu</button>
        <slot />
      </main>
    </div>

    <dialog class="confirm" id="confirm" aria-labelledby="confirm-title">
      <form method="dialog">
        <div class="body">
          <h2 id="confirm-title"></h2>
          <p id="confirm-text"></p>
          <label class="field" id="confirm-typed" hidden>
            <span id="confirm-typed-label"></span>
            <input type="text" autocomplete="off" spellcheck="false" />
          </label>
        </div>
        <div class="foot">
          <button class="btn" value="cancel" type="submit">Cancel</button>
          <button class="btn danger solid" value="ok" type="submit" id="confirm-ok"></button>
        </div>
      </form>
    </dialog>
    <div class="toasts" id="toasts" role="status" aria-live="polite"></div>
    <script>
      import { boot } from "../lib/shell";
      boot();
    </script>
  </body>
</html>
