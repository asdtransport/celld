---
interface Props { id: string; title: string; submit?: string; formId?: string }
const { id, title, submit, formId } = Astro.props;
---
<dialog class="drawer" id={id} aria-labelledby={`${id}-title`}>
  <div class="drawer-head">
    <h2 id={`${id}-title`}>{title}</h2>
    <button class="icon-btn" type="button" data-drawer-close aria-label="Close">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </div>
  <div class="drawer-body"><slot /></div>
  {submit && (
    <div class="drawer-foot">
      <button class="btn" type="button" data-drawer-close>Cancel</button>
      <button class="btn primary" type="submit" form={formId}>{submit}</button>
    </div>
  )}
</dialog>
