#!/bin/sh
# fleetiq CLI, run from this checkout with Bun. Teammates install the copy their console serves:
#   curl -fsSL https://console.<domain>/cli/install.sh | sh        (Windows: irm https://console.<domain>/cli/install.ps1 | iex)
DIR=$(cd "$(dirname "$0")/.." && pwd)
if command -v bun >/dev/null 2>&1; then exec bun "$DIR/cli/fleetiq.ts" "$@"; fi
echo "fleetiq: run it with Bun (https://bun.sh), or install it from your console: curl -fsSL https://console.<domain>/cli/install.sh | sh" >&2
exit 1
