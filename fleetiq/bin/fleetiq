#!/usr/bin/env bash
# fleetiq — command line for the FleetIQ API. Needs curl; jq makes the output nicer if present.
#
#   export FLEETIQ_URL=https://console.example.com FLEETIQ_TOKEN=fiq_...   (Console → Access → API tokens)
#   fleetiq status
#   fleetiq deploy notes --git            # build + deploy from the app's Git source, wait for it
#   fleetiq deploy notes ./notes.tgz      # deploy a workiq-pack archive
#   fleetiq deploy notes --dir ./notes    # build + deploy a local project folder on the server
#   fleetiq help
set -euo pipefail
set -f   # no globbing: FLEETIQ_CURL_ARGS may contain *'s

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/fleetiq/env"
[ -f "$CONF" ] && . "$CONF"
URL="${FLEETIQ_URL:-}"; TOKEN="${FLEETIQ_TOKEN:-}"
die() { printf 'fleetiq: %s\n' "$*" >&2; exit 1; }
pretty() { if command -v jq >/dev/null; then jq "${1:-.}"; else cat; echo; fi; }

call() { # call METHOD PATH [JSON]
  [ -n "$URL" ] && [ -n "$TOKEN" ] || die "set FLEETIQ_URL and FLEETIQ_TOKEN (or run: fleetiq login)"
  local m="$1" p="$2" body="${3:-}" out code
  out=$(mktemp); trap 'rm -f "$out"' RETURN
  if [ -n "$body" ]; then code=$(curl -sS ${FLEETIQ_CURL_ARGS:-} -o "$out" -w '%{http_code}' -X "$m" -H "authorization: Bearer $TOKEN" -H 'content-type: application/json' --data "$body" "$URL$p")
  else code=$(curl -sS ${FLEETIQ_CURL_ARGS:-} -o "$out" -w '%{http_code}' -X "$m" -H "authorization: Bearer $TOKEN" "$URL$p"); fi
  cat "$out"
  [ "$code" -lt 400 ] || { echo >&2; die "HTTP $code from $m $p"; }
}
upload() { # upload PATH FIELD FILE [extra -F args...]
  local p="$1" field="$2" file="$3"; shift 3
  curl -sS ${FLEETIQ_CURL_ARGS:-} --fail-with-body -X POST -H "authorization: Bearer $TOKEN" -F "$field=@$file" "$@" "$URL$p"
}
follow() { # follow DEPLOYMENT_JSON — wait for it and print the log
  local id status
  id=$(sed -n 's/.*"id":"\(dep_[^"]*\)".*/\1/p' <<<"$1" | head -1)
  [ -n "$id" ] || { echo "$1" | pretty; return; }
  echo "deployment $id — building and deploying…" >&2
  while :; do
    local d; d=$(call GET "/api/deployments/$id/wait?timeout=120")
    status=$(sed -n 's/.*"status":"\([a-z]*\)".*/\1/p' <<<"$d" | head -1)
    [ "$status" = running ] && continue
    if command -v jq >/dev/null; then jq -r '.log' <<<"$d"; else echo "$d"; fi
    echo "→ $status" >&2
    [ "$status" = succeeded ]; return
  done
}
J() { # J key=value ... → JSON object (numbers/true/false stay unquoted)
  local out="{" sep="" k v
  for kv in "$@"; do k="${kv%%=*}"; v="${kv#*=}"
    if [[ "$v" =~ ^(true|false|null|-?[0-9]+)$ ]]; then out+="$sep\"$k\":$v"; else v=${v//\\/\\\\}; v=${v//\"/\\\"}; out+="$sep\"$k\":\"$v\""; fi; sep=","
  done; echo "$out}"
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  login)
    read -rp "Console URL (https://console.…): " URL; read -rsp "API token (fiq_…): " TOKEN; echo
    mkdir -p "$(dirname "$CONF")"; umask 077; printf 'FLEETIQ_URL=%q\nFLEETIQ_TOKEN=%q\n' "${URL%/}" "$TOKEN" > "$CONF"
    URL="${URL%/}"; call GET /api/system >/dev/null && echo "saved to $CONF" ;;
  status) call GET /api/system | pretty '{fleetiq, apps, builder}' ;;
  apps) call GET /api/apps | pretty '[.[] | {name, version, liveNodes, desiredNodes, managed}]' ;;
  app) call GET "/api/apps/$1" | pretty ;;
  create) # create NAME [nodes] [health]
    call POST /api/apps "$(J name="$1" managed=true desiredNodes="${2:-2}" healthPath="${3:-/api/health}")" | pretty
    call POST "/api/apps/$1/scale" "$(J nodes="${2:-2}")" | pretty ;;
  scale) call POST "/api/apps/$1/scale" "$(J nodes="$2")" | pretty ;;
  source) # source NAME OWNER/REPO [REF] [PATH] [auto]
    call PUT "/api/apps/$1/source" "$(J repo="$2" ref="${3:-main}" path="${4:-}" autoDeploy="$([ "${5:-}" = auto ] && echo true || echo false)")" | pretty ;;
  deploy) # deploy NAME (--git [REF] | --dir DIR | FILE.tgz)
    name="$1"; shift
    case "${1:-}" in
      --git) follow "$(call POST "/api/apps/$name/deploy/git" "$( [ -n "${2:-}" ] && J ref="$2" || echo '{}')")" ;;
      --dir)
        d="${2:?folder}"; t=$(mktemp -t src.XXXXXX).tgz
        tar czf "$t" -C "$d" --exclude ./node_modules --exclude '*/node_modules' --exclude ./.git --exclude ./.celld --exclude ./web/dist .
        follow "$(upload "/api/apps/$name/deploy/source" source "$t")"; rm -f "$t" ;;
      *.tgz|*.tar.gz) upload "/api/apps/$name/deploy" bundle "$1" | pretty '{status, version, warning, log}' ;;
      *) die "deploy NAME --git [REF] | --dir FOLDER | FILE.tgz" ;;
    esac ;;
  wait) follow "{\"id\":\"$1\"}" ;;
  deployments) call GET "/api/apps/$1/deployments" | pretty '[.[] | {id, status, version, source, actor, startedAt}]' ;;
  versions) call GET "/api/apps/$1/versions" | pretty ;;
  rollback) call POST "/api/apps/$1/rollback" "$(J version="$2")" | pretty '{status, version, warning}' ;;
  route) call PUT /api/routes "$(J host="$1" app="$2")" | pretty ;;
  unroute) call DELETE "/api/routes?host=$1" | pretty ;;
  routes) call GET /api/routes | pretty '.routes' ;;
  logs) call GET "/api/apps/$1/logs?tail=${2:-100}" | (command -v jq >/dev/null && jq -r '.[] | "==> \(.container) (\(.state))\n\(.logs)"' || cat) ;;
  sql) call POST "/api/apps/$1/d1/$2/query" "$(J sql="$3")" | pretty ;;
  containers) call GET /api/containers | pretty '[.[] | {name, state, status}]' ;;
  restart|stop|start) call POST "/api/containers/$1/$cmd" | pretty ;;
  activity) call GET "/api/audit?limit=${1:-30}" | pretty '[.[] | "\(.at|todate) \(.actor): \(.action) \(.target) \(.outcome)"]' ;;
  api) call "$1" "$2" "${3:-}" | pretty ;;
  ops) curl -sS ${FLEETIQ_CURL_ARGS:-} "$URL/api/openapi.json" | (command -v jq >/dev/null && jq -r '.paths | to_entries[] | .key as $p | .value | to_entries[] | "\(.key|ascii_upcase)\t\($p)\t\(.value.summary)"' || cat) ;;
  mcp) echo "MCP endpoint: $URL/mcp  (Authorization: Bearer <token>)"; echo "No-header clients: $URL/mcp/t/<token>" ;;
  help|*) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
    cat <<'EOF'
Commands:
  login | status | apps | app NAME | create NAME [NODES] [HEALTH] | scale NAME N
  source NAME OWNER/REPO [REF] [PATH] [auto] | deploy NAME --git [REF] | --dir DIR | FILE.tgz
  wait DEP_ID | deployments NAME | versions NAME | rollback NAME VERSION
  route HOST APP | unroute HOST | routes | logs NAME [TAIL] | sql NAME DB "SQL"
  containers | restart|stop|start CONTAINER | activity [N] | api METHOD PATH [JSON] | ops | mcp
EOF
  ;;
esac
